# Server only. Do not commit real values.
TA_ASSESS_SERVER_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Google Apps Script must use the same value as TA_ASSESS_SERVER_SECRET.
# This value belongs in Apps Script Project Settings > Script Properties.
TA_SERVER_SHARED_SECRET=use-the-same-long-random-secret-as-vercel

# Separate administrator password. Never put the real value in GitHub or frontend code.
TA_ADMIN_PASSWORD=replace-with-a-separate-admin-password
